# ═══════════════════════════════════════════════════════════════════════════
# Readwise → Day One Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ── Required: Readwise API ──────────────────────────────────────────────────
# Get your token from: https://readwise.io/access_token
READWISE_TOKEN=your_readwise_token_here

# ── Required: Day One Output Method ─────────────────────────────────────────
# Choose ONE method: CLI (macOS) OR Email (any platform)

# Method A: Day One CLI (macOS only)
USE_CLI=true

# Method B: Email-to-Journal (any platform)
# Get your email address from Day One → Settings → Email-to-Journal
DAYONE_EMAIL=your_journal_email@journal.dayone.app

# ── SMTP Configuration (for email method) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# ── Optional: Entry Creation Mode (for sync_readwise_ultimate.py) ───────────
# Create individual detailed entries for each article (default: true)
CREATE_INDIVIDUAL_ENTRIES=true

# Create a daily summary rollup entry (default: false)
# You can enable both to get individual entries AND a daily summary!
CREATE_DAILY_SUMMARY=false

# ── Optional: Filtering Settings ────────────────────────────────────────────
# Only include articles with reading progress >= this threshold
# 0.95 = 95% read, 1.0 = 100% read, 0.80 = 80% read
READING_PROGRESS_THRESHOLD=0.95

# How many days back to check for finished articles
# 1 = yesterday + today, 7 = last week, etc.
DAYS_BACK=1 