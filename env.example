# Readwise API Configuration
# Get your token from: https://readwise.io/access_token
READWISE_TOKEN=your_readwise_token_here

# Day One Configuration
# Choose ONE method: CLI (macOS) OR Email (any platform)

# Method A: Day One CLI (macOS only)
USE_CLI=true

# Method B: Email-to-Journal (any platform)
# Get your email address from Day One → Settings → Email-to-Journal
DAYONE_EMAIL=your_journal_email@journal.dayone.app

# SMTP Configuration (for email method)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

DEBUG: Using today=YYYY-MM-DD for updatedAfter param 