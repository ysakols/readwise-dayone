# Readwise → Day One Configuration

# Required: Readwise API token
# Get your token from: https://readwise.io/access_token
READWISE_TOKEN=your_readwise_token_here

# Required: Day One email-to-journal address
# Get from Day One → Settings → Email-to-Journal
DAYONE_EMAIL=your_journal_email@journal.dayone.app

# Required: SMTP Configuration (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Optional: Use Day One CLI instead of email (macOS only)
# USE_CLI=true

# Optional: Categories to sync (default: article,rss,email)
# CATEGORIES=article,rss,email

# Optional: Days back to check for archived items (default: 1)
# DAYS_BACK=1

# Optional: Delay between emails in seconds (default: 2.0)
# EMAIL_DELAY=2.0

# Optional: Create daily summary in addition to individual entries
# CREATE_DAILY_SUMMARY=false
